# ==============================================================================
# Cloned Application Configuration
# ==============================================================================
# The directory name of the cloned repository inside ./app/
APP_DIRNAME=

# Application entrypoint: <module_file>:<callable_object>
# Examples:
#   Flask:     index:app  or  app:app
#   FastAPI:   main:app   or  app:api
#   Django:    my_project.wsgi:application
GRANIAN_TARGET=index:app

# ==============================================================================
# Granian Server Configuration
# ==============================================================================
# Interface:
#   wsgi -> for Flask, Django, Bottle
#   asgi -> for FastAPI, Starlette, Litestar
GRANIAN_INTERFACE=wsgi

# Host to bind inside the container (0.0.0.0 is required for Docker port forwarding)
GRANIAN_HOST=0.0.0.0

# Port on which the server listens inside the container
GRANIAN_PORT=5000

# Worker and thread concurrency
GRANIAN_WORKERS=2
GRANIAN_THREADS=1

# Log level: info, warning, error, debug
GRANIAN_LOG_LEVEL=info

# ==============================================================================
# Python & Container Runtime Configuration
# ==============================================================================
# Force unbuffered stdout/stderr so logs appear in real time in `docker logs`
PYTHONUNBUFFERED=1

# Optional override path to .env inside container
# DOTENV_PATH=.env

# ==============================================================================
# Application & JWT Authentication Settings (For Mock Server)
# ==============================================================================
# Secret key used for signing and verifying JWT tokens
SECRET_KEY=change-this-to-a-secure-random-secret-key

# JWT Signing Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT Token validity in seconds (3600 = 1 hour)
TOKEN_EXPIRATION=3600

# Valid credentials for /auth/token and sale cancel endpoints
VALID_USERNAME=admin
VALID_PASSWORD=admin
